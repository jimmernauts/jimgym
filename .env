# local & local_docker: data/ directory is relative to the project root
# fly: /data/ directory is absolute path on machine, points to fly volume
DATABASE_URL=sqlite:data/jimgym.db
DATABASE_PATH="file:data/jimgym.db?mode=rwc&cache=shared"
DBMATE_MIGRATIONS_DIR=schema/migrations
DBMATE_SCHEMA_FILE=schema/schema.sql
ESQLITE_USE_SYSTEM=true
ENVIRONMENT=local
#local: set these, we want to be able to restore the DB from a backup. we won't accidentally create a new backup because we aren't running 
#local-docker: don't set these, we only want to backup the DB on app startup in prod

S3_BUCKET=jimgym-backup
S3_ENDPOINT=https://fly.storage.tigris.dev
