{
  "$schema": "https://biomejs.dev/schemas/2.0.5/schema.json",
  "formatter": {
    "enabled": true
  },
  "files": {
    "includes": ["src/**/*.{js,ts}", "test/**/*.{js,ts}"]
  },
  "linter": {
